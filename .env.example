# Backend
# Локально: http://localhost:5173
# На сервере без домена: http://IP_СЕРВЕРА:8080 (порт 80 занят системным сервисом, поэтому используем 8080)
# Пример для сервера с IP 193.5.251.188:
CORS_ORIGINS=http://localhost:5173,http://193.5.251.188:8080

# Frontend (передаются как build args в docker-compose)
# WS (игровой трафик) идёт через ws-gateway (Go) на порту 8000.
# HTTP API (leaderboard и т.п.) идёт напрямую в backend на порту 8001.
# Для локальной разработки закомментируйте серверные строки ниже и раскомментируйте эти:
# VITE_API_URL=http://localhost:8001
# VITE_WS_URL=ws://localhost:8000/ws/game
# На сервере без домена (пример для IP 193.5.251.188):
VITE_API_URL=http://193.5.251.188:8001
VITE_WS_URL=ws://193.5.251.188:8000/ws/game
